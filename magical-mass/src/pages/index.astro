---
import '../styles/global.css';

const skills = [
	{ name: 'PHP', level: 60 },
	{ name: 'Python', level: 70 },
	{ name: 'C#', level: 50 },
	{ name: 'HTML/CSS', level: 100 },
	{ name: 'WordPress', level: 60 },
	{ name: 'JavaScript', level: 70 },
	{ name: 'React', level: 80 },
	{ name: 'TypeScript', level: 70 },
];

const languages = ['Nederlands', 'Engels'];

const traits = [
	'Enthousiast',
	'Stressbestendig',
	'Zelfstandig',
	'Flexibel',
	'Verantwoordelijkheidsgevoel',
	'Communicatief',
	'Klantgericht',
	'Sociaal',
];

const experience = [
	{
		role: 'Batterijwisselaar',
		company: 'Check',
		period: 'sinds 2026 - heden',
		points: [
			'Ik wissel dagelijks batterijen van deelvoertuigen door de stad, zodat ze altijd inzetbaar blijven.',
			'Ik werk zelfstandig en plan mijn eigen route, en combineer dit met mijn opleiding.',
		],
	},
	{
		role: 'Full Stack Developer (stage)',
		company: 'Axoft IT & Telecom',
		period: 'september 2024 — mei 2025',
		points: [
			'Ik heb ervaren hoe het bedrijfsleven écht in elkaar zit, en hoe je samenwerkt met andere programmeurs en collega’s van andere afdelingen.',
			'Ik heb mijn kennis uitgebreid en geleerd om veilig en gestructureerd te coderen.',
		],
	},
	{
		role: 'Pakkettenbezorger',
		company: 'DHL, Rotterdam',
		period: 'juli 2023 — juli 2024',
		points: [
			'Ik ging verantwoordelijk om met pakketten en zorgde voor een veilige en tijdige bezorging.',
			'Ik sorteerde pakketten vooraf op bezorgvolgorde, waardoor ik efficiënter kon bezorgen.',
		],
	},
	{
		role: 'Barmedewerker',
		company: 'Maassilo, Rotterdam',
		period: 'februari 2022 — mei 2023',
		points: [
			'Ik leerde omgaan met lastige situaties en drukte achter de bar.',
			'Ik bleef professioneel, ook wanneer klanten zich anders gingen gedragen.',
		],
	},
	{
		role: 'Bezorger',
		company: 'Thuisbezorgd, Rotterdam',
		period: 'november 2021 — oktober 2022',
		points: [
			'Ik werkte zelfstandig en was verantwoordelijk voor het ophalen en bezorgen van bestellingen.',
		],
	},
	{
		role: 'Vulploegmedewerker',
		company: 'Dirk van den Broek, Rotterdam',
		period: 'februari 2020 — november 2021',
		points: [
			'Ik leerde efficiënt en klantgericht werken tijdens het vullen van de schappen.',
			'Ik werkte goed samen met collega’s en leidinggevenden om teamdoelen te behalen.',
		],
	},
];

const education = [
	{
		role: 'Software Development (HBO AD)',
		company: 'Hogeschool Rotterdam',
		period: 'sinds januari 2026 - heden',
		points: ['Eerstejaars, met als doel zoveel mogelijk softwarevaardigheden op te doen voor mijn beroep.'],
	},
	{
		role: 'Software Development',
		company: 'Grafisch Lyceum Rotterdam (MBO)',
		period: 'september 2021 — 2025',
		points: ['MBO niveau 4, met focus op webontwikkeling en programmeren.'],
	},
	{
		role: 'Mavo diploma',
		company: 'Mavo Centraal, Rotterdam',
		period: 'september 2019 — juni 2021',
		points: ['Afgerond met mavo-diploma.'],
	},
];
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio van Shemar Braafheid, software developer in opleiding uit Rotterdam. PHP, C#, JavaScript, HTML/CSS en WordPress."
		/>
		<title>Shemar Braafheid Software Developer</title>
	</head>
	<body>
		<canvas id="bg-canvas" aria-hidden="true"></canvas>

		<header class="navbar">
			<a href="#hero" class="logo">Shemar<span>.</span></a>
			<nav>
				<a href="#about">Over mij</a>
				<a href="#skills">Skills</a>
				<a href="#experience">Ervaring</a>
				<a href="#contact">Contact</a>
			</nav>
		</header>

		<main>
			<section id="hero" class="hero">
				<img class="avatar" src="/shemar.jpeg" alt="Foto van Shemar Braafheid" width="240" height="240" />
				<h1>Hoi, ik ben Shemar</h1>
				<p class="role">Software Developer in opleiding &mdash; Rotterdam</p>
				<p class="intro">
					Brede werkervaring in klantcontact en teamwork, gecombineerd met een groeiende toolkit in PHP,
					C#, JavaScript en React &mdash; op weg naar een carri&egrave;re als developer.
				</p>
				<div class="buttons">
					<a class="btn btn-primary" href="#contact">Neem contact op</a>
					<a class="btn" href="#skills">Bekijk mijn skills</a>
				</div>
			</section>

			<section id="about" class="section">
				<h2>Over mij</h2>
				<p>
					Ik ben Shemar, 22 jaar. Ik ben geboren in Nederland en woon al mijn hele leven in Rotterdam-West,
					samen met mijn ouders, broertje en zusje. Ik volg de opleiding
					Software Development (HBO AD) aan Hogeschool Rotterdam, waar ik nu in mijn eerste
					jaar zit.
				</p>
				<p>
					Naast school werk ik als Batterijwisselaar bij Check. Daarvoor heb ik onder andere bij DHL,
					Maassilo en Thuisbezorgd gewerkt, waar ik heb geleerd om verantwoordelijk, klantgericht en
					stressbestendig te werken.
				</p>
				<p>
					In mijn vrije tijd voetbal ik, spreek ik graag met vrienden af, luister ik muziek, ga ik naar de
					sportschool en kijk ik soms een anime of serie. Mijn doel is om zoveel mogelijk kennis en
					softwarevaardigheden op te doen voor mijn toekomstige beroep &mdash; daarom heb ik voor deze
					opleiding gekozen, en het liefst ga ik na mijn studie direct aan de slag zodra de kans zich
					voordoet.
				</p>
			</section>

			<section id="skills" class="section">
				<h2>Skills</h2>
				<div class="skills-grid">
					{
						skills.map((skill) => (
							<div class="skill-card">
								<p class="skill-name">{skill.name}</p>
								<div class="bar">
									<div class="bar-fill" style={`width:${skill.level}%`} />
								</div>
							</div>
						))
					}
				</div>

				<h3>Talen</h3>
				<ul class="tags">
					{languages.map((lang) => (
						<li class="tag">{lang}</li>
					))}
				</ul>

				<h3>Eigenschappen</h3>
				<ul class="tags">
					{traits.map((trait) => (
						<li class="tag">{trait}</li>
					))}
				</ul>
			</section>

			<section id="experience" class="section">
				<h2>Ervaring</h2>

				<h3>Werkervaring</h3>
				<div class="cards">
					{
						experience.map((item) => (
							<div class="card">
								<div class="card-head">
									<h4>
										{item.role} &mdash; {item.company}
									</h4>
									<span class="period">{item.period}</span>
								</div>
								<ul>
									{item.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<h3>Opleiding</h3>
				<div class="cards">
					{
						education.map((item) => (
							<div class="card">
								<div class="card-head">
									<h4>
										{item.role} &mdash; {item.company}
									</h4>
									<span class="period">{item.period}</span>
								</div>
								<ul>
									{item.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<section id="contact" class="section">
				<h2>Contact</h2>
				<p>Altijd open voor een stage, bijbaan of gewoon een goed gesprek over code.</p>
				<ul class="contact-list">
					<li>
						<svg
							class="icon-svg"
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="2" y="4" width="20" height="16" rx="2" />
							<path d="m22 6-10 7L2 6" />
						</svg>
						<a href="mailto:shemarbraafheid2017@gmail.com">shemarbraafheid2017@gmail.com</a>
					</li>
					<li>
						<svg class="icon-svg" viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
								0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
								1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
								0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4 0c1.53-1.04
								2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54
								1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
						</svg>
						<a href="https://github.com/Shemar-126662" target="_blank" rel="noreferrer noopener">
							github.com/Shemar-126662
						</a>
					</li>
					<li>
						<svg
							class="icon-svg"
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
							<circle cx="12" cy="10" r="3" />
						</svg>
						<span>Rotterdam-West, Nederland</span>
					</li>
				</ul>
			</section>
		</main>

		<footer>
			<p>{new Date().getFullYear()} Shemar Braafheid. Gebouwd met Astro.</p>
		</footer>

		<script>
			import '../scripts/bg-canvas.js';
		</script>
	</body>
</html>
